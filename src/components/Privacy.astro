---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { localPath, type Locale } from '../i18n/locales';
import { t } from '../i18n/translations';
import { PHONE, whatsappUrl } from '../lib/submission';
const { locale } = Astro.props as { locale: Locale };
const c = t(locale);
---

<BaseLayout
  locale={locale}
  title={`${c.privacy.title} — NS Dev`}
  description={c.privacy.intro}
  route="privacy/"
>
  <section class="container prose-page">
    <a class="text-link case-back" href={localPath(locale)}>
      <Icon name="ArrowLeft" size={18} />
      {c.notFound.home}
    </a>
    <h1>{c.privacy.title}</h1>
    <p class="prose-intro">{c.privacy.intro}</p>
    {c.privacy.blocks.map((block) => (
      <article>
        <h2>{block.title}</h2>
        <p>{block.text}</p>
      </article>
    ))}
    <div class="actions">
      <a
        class="button"
        href={whatsappUrl(c.contact.directMessage)}
        target="_blank"
        rel="noopener noreferrer"
      >
        {PHONE}
        <Icon name="ArrowUpRight" size={18} />
      </a>
      <a
        class="text-link"
        href={`https://www.whatsapp.com/legal/privacy-policy`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {c.privacy.whatsappPolicy}
        <Icon name="ArrowUpRight" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>
