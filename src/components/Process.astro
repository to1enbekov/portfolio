---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/translations';
import Icon from './Icon.astro';
const { locale } = Astro.props as { locale: Locale };
const c = t(locale);
---

<section class="section container" id="process" aria-labelledby="process-title">
  <div class="section-heading">
    <p class="eyebrow">{c.process.eyebrow}</p>
    <div>
      <h2 class="line-breaks" id="process-title">
        {c.process.title}
      </h2>
      <p class="section-description">{c.process.description}</p>
    </div>
  </div>
  <ol class="process-grid">
    {c.process.steps.map((step, i) => (
      <li>
        <div class="step-number">
          <span>0{i + 1}</span>
          {i < 4 && <Icon name="ArrowRight" size={18} />}
        </div>
        <h3>{step.title}</h3>
        <p>{step.text}</p>
      </li>
    ))}
  </ol>
</section>
