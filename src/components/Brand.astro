---
import { assetPath, localPath, type Locale } from '../i18n/locales';
interface Props {
  locale: Locale;
  dark?: boolean;
}
const { locale, dark = false } = Astro.props;
---

<a class="brand" href={localPath(locale)} aria-label="NS Dev">
  <img
    src={assetPath(`assets/brand/ns-mark${dark ? '-white' : ''}.png`)}
    width="38"
    height="44"
    alt=""
  />
  <span>
    NS <span class="brand-dev">Dev</span>
  </span>
</a>
