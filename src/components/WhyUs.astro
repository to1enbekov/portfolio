---
import type { Locale } from '../i18n/locales';
import { t } from '../i18n/translations';
import { assetPath } from '../i18n/locales';
const { locale } = Astro.props as { locale: Locale };
const c = t(locale);
---

<section class="why-section" aria-labelledby="why-title">
  <div class="container section why-layout">
    <div class="why-heading">
      <p class="eyebrow">{c.why.eyebrow}</p>
      <h2 id="why-title" class="line-breaks">
        {c.why.title}
      </h2>
      <p>{c.why.description}</p>
      <img
        src={assetPath('assets/brand/ns-mark-white.png')}
        width="104"
        height="120"
        alt=""
        loading="lazy"
      />
    </div>
    <div class="why-items">
      {c.why.items.map((item, i) => (
        <article>
          <span>0{i + 1}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
