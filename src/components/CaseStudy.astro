---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
import { projects, type Project } from '../data/projects';
import { localPath, type Locale } from '../i18n/locales';
import { t } from '../i18n/translations';
const { project, locale } = Astro.props as { project: Project; locale: Locale };
const c = t(locale);
const copy = project.copy[locale];
const next = projects[(projects.indexOf(project) + 1) % projects.length]!;
---

<BaseLayout
  locale={locale}
  title={`${project.name} — ${copy.category} | NS Dev`}
  description={copy.summary}
  route={`projects/${project.slug}/`}
>
  <div class="container">
    <header class="case-header">
      <a class="text-link case-back" href={`${localPath(locale)}#projects`}>
        <Icon name="ArrowLeft" size={18} />
        {c.case.back}
      </a>
      <div class="case-meta">
        <p class="eyebrow">{c.case.label}</p>
        <p class="eyebrow">{copy.category}</p>
      </div>
      <h1>{project.name}</h1>
      <p class="case-summary">{copy.summary}</p>
    </header>
    <div class="case-image">
      <ProjectVisual project={project} locale={locale} large eager />
    </div>
    <p class="image-caption">
      {project.image ? c.case.captured : c.case.branded}
    </p>
    <div class="case-details">
      <aside>
        {project.stack.length > 0 && (
          <>
            <h2>{c.case.stack}</h2>
            <div class="stack-tags">
              {project.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </>
        )}
        <h2>{c.case.links}</h2>
        <div class="case-links">
          {project.links.map((link) => (
            <a
              class="text-link"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              {c.work[link.label]}
              <Icon name="ArrowUpRight" size={18} />
            </a>
          ))}
        </div>
      </aside>
      <article class="case-body">
        <h2>{c.case.task}</h2>
        <p>{copy.task}</p>
        <h2>{c.case.approach}</h2>
        <ul class="case-features">
          {copy.features.map((feature, i) => (
            <li>
              <span>0{i + 1}</span>
              {feature}
            </li>
          ))}
        </ul>
        {copy.note && <p class="case-note">{copy.note}</p>}
      </article>
    </div>
    <section class="case-cta">
      <div>
        <h2>{c.case.cta}</h2>
        <p>{c.case.ctaText}</p>
      </div>
      <a
        class="button"
        href={`${localPath(locale)}?service=${project.service}#contact`}
      >
        {c.case.similar}
        <Icon name="ArrowUpRight" size={18} />
      </a>
    </section>
    <a class="case-next" href={localPath(locale, `projects/${next.slug}/`)}>
      <div>
        <p class="eyebrow">{c.case.next}</p>
        <h3>{next.name}</h3>
      </div>
      <Icon name="ArrowRight" size={32} />
    </a>
  </div>
</BaseLayout>
